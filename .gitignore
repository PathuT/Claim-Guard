# Secrets — never commit
.env
.env.local
*.pem
*.key

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
backend/uv.lock.tmp

# Node / Next.js
node_modules/
frontend/.next/
frontend/out/
frontend/.env*.local
npm-debug.log*

# Editors / OS
.DS_Store
.vscode/
.idea/

# Synthetic data artifacts (generated by `make seed` / generators/, not source —
# deterministic and reproducible, so not committed; see data/synthetic/generators/)
data/synthetic/generated/
data/synthetic/documents/*.pdf

# Real documents uploaded via POST /claims/new (api/claim_intake.py) —
# whatever a real user actually attaches, never synthetic/reproducible.
data/uploads/*

# AGT FlightRecorder audit trail (governance/flight_recorder.py) — local
# state, not source; grows with every tool call once agents exist (M4+).
# SQLite's own WAL-mode sidecar files (-shm/-wal) are equally runtime state,
# not source — they were previously untracked only for the base .db file,
# so every agent run kept re-dirtying the working tree with binary diffs.
flight_recorder.db
flight_recorder.db-shm
flight_recorder.db-wal
backend/flight_recorder.db
backend/flight_recorder.db-shm
backend/flight_recorder.db-wal

# Harbor's own per-run job output (evals/harbor/jobs/<timestamp>/ — logs,
# trial artifacts) — created fresh by every `harbor run`/`make eval`, not
# source.
evals/harbor/jobs/

# Sample document packs rendered on demand for the Console Story view
# (backend/api/story_support.py) — reproducible, not source.
data/samples/
