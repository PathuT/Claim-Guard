# Copy to .env and fill in real values. Never commit .env.

# --- Database (Supabase Postgres, or any Postgres 16 + pgvector) ---
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres

# --- LLM provider (Agno is model-agnostic; set whichever provider's key you use) ---
# Which model each agent uses is chosen in code (backend/agents/), not here —
# this just holds whatever provider key(s) that code calls.
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Phoenix (observability) ---
# Run locally with: uv run phoenix serve
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PORT=6006

# --- Token service ---
TOKEN_SERVICE_PORT=8100
# Ed25519 signing key for the token service (base64-encoded PKCS8 PEM) —
# generate per environment, never share. REQUIRED once the token service and
# data gateway run as separate processes: without it, each process generates
# its own random key, and the gateway can't verify tokens the token service
# issued (confirmed as a real bug in M2). Generate one with:
#   uv run python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; from cryptography.hazmat.primitives import serialization; import base64; k=Ed25519PrivateKey.generate(); print(base64.b64encode(k.private_bytes(encoding=serialization.Encoding.PEM, format=serialization.PrivateFormat.PKCS8, encryption_algorithm=serialization.NoEncryption())).decode())"
TOKEN_SERVICE_PRIVATE_KEY=

# --- Agent identities (AGT / governance/identity.py) ---
# Ed25519 seeds (base64-encoded, 32 raw bytes), one per ClaimGuard agent —
# generate per environment, never share. REQUIRED once agents and the token
# service run as separate processes: without these, each process generates
# its own random identity per agent, and signatures never verify across
# processes (confirmed as a real bug in M3, same class as
# TOKEN_SERVICE_PRIVATE_KEY above). Generate with:
#   uv run python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; from cryptography.hazmat.primitives import serialization; import base64; k=Ed25519PrivateKey.generate(); print(base64.b64encode(k.private_bytes(encoding=serialization.Encoding.Raw, format=serialization.PrivateFormat.Raw, encryption_algorithm=serialization.NoEncryption())).decode())"
AGENT_IDENTITY_SEED_SUPERVISOR=
AGENT_IDENTITY_SEED_INTAKE=
AGENT_IDENTITY_SEED_MEDICAL_REVIEWER=
AGENT_IDENTITY_SEED_COVERAGE=
AGENT_IDENTITY_SEED_FRAUD=
AGENT_IDENTITY_SEED_PAYOUT=

# --- Data gateway ---
DATA_GATEWAY_PORT=8200
# HMAC key for pseudonymising claims:read_pseudonymised (fraud agent only) —
# docs/security-matrix.md §10: "Pseudonymisation HMAC key only in the data
# gateway." A random 32-byte key is fine; it's never shared with any agent,
# so nothing verifies against it besides the gateway re-hashing to compare.
# Generate with:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
PSEUDONYMISATION_HMAC_KEY=

# --- Payments mock ---
PAYMENTS_MOCK_PORT=8300

# --- AgentOS (Agno) ---
AGENTOS_PORT=8000

# --- NeMo Guardrails (ADR-013, advisory only) ---
# Off by default. When "true", document_guardrail also runs NeMo's
# self-check-input rail as a second, advisory opinion alongside the
# marker-list scan — it can only ADD a T3 flag, never clear one. Uses an
# NVIDIA NIM model (engine: nim) for the rail check only — the six
# ClaimGuard agents are unaffected and keep using GROQ_API_KEY/
# GEMINI_API_KEY above. Install with: uv sync --extra nemo (backend/)
NEMO_GUARDRAILS_ENABLED=false
# Get a key at https://build.nvidia.com. Used only by NeMo's rail check.
NVIDIA_API_KEY=

# --- Officer decision API ---
# M8 (Console): the officer's decide-on-a-T3-claim action calls this API
# directly, never api.agentos.
OFFICER_API_PORT=8400

# --- Frontend ---
NEXT_PUBLIC_AGENTOS_URL=http://localhost:8000
NEXT_PUBLIC_OFFICER_API_URL=http://localhost:8400
# Console sign-in: put this one in frontend/.env.local (git-ignored), 32+ random characters.
# CONSOLE_SESSION_SECRET=
FRONTEND_PORT=3005
