# ClaimGuard environment. Copy to `.env` at the repo root and fill in the values.
# Every backend service reads this one file. Never commit `.env`.
#
# Required: DATABASE_URL, one LLM key, TOKEN_SERVICE_PRIVATE_KEY,
#           the six AGENT_IDENTITY_SEED_* values, PSEUDONYMISATION_HMAC_KEY.
# Optional: everything marked (optional).

# --- Database: Postgres 16+ (a free Supabase project works) ------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/claimguard
# (optional) Direct/session connection for migrations and seeding; defaults to DATABASE_URL.
DIRECT_URL=

# --- LLM provider for the agents (Agno is model-agnostic) -------------------------
# MODEL_PROVIDER: groq (default) or gemini. Set the matching key below.
MODEL_PROVIDER=groq
# (optional) Override the model id. Defaults: groq -> openai/gpt-oss-120b,
# gemini -> gemini-3.7-flash.
MODEL_ID=
GROQ_API_KEY=
GEMINI_API_KEY=
# (optional) Only used by the standalone smoke test `npm run dev:hello-agent`.
ANTHROPIC_API_KEY=

# --- NeMo guardrail: NVIDIA NIM content-safety model (ADR-013, advisory) ----------
# When true, every document is also checked by NVIDIA's content-safety model as a
# second opinion next to the deterministic injection scan. It can only add a
# "send to an officer" flag, never clear one, and if the call fails the claim
# continues on the deterministic scan alone. Key: https://build.nvidia.com
NEMO_GUARDRAILS_ENABLED=true
NVIDIA_API_KEY=
# (optional) Override the NIM model used for the check.
NEMO_RAIL_MODEL_ID=nvidia/nemotron-3.5-content-safety

# --- Token service (EdDSA JWTs) ---------------------------------------------------
# Ed25519 private key, base64 of a PKCS8 PEM. Generate (from backend/):
#   uv run python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey as K; from cryptography.hazmat.primitives import serialization as s; import base64; print(base64.b64encode(K.generate().private_bytes(s.Encoding.PEM, s.PrivateFormat.PKCS8, s.NoEncryption())).decode())"
TOKEN_SERVICE_PRIVATE_KEY=
TOKEN_SERVICE_PORT=8100

# --- Agent identities (AGT, Ed25519) ----------------------------------------------
# One 32-byte seed per agent, base64. Generate each (from backend/):
#   uv run python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
AGENT_IDENTITY_SEED_SUPERVISOR=
AGENT_IDENTITY_SEED_INTAKE=
AGENT_IDENTITY_SEED_MEDICAL_REVIEWER=
AGENT_IDENTITY_SEED_COVERAGE=
AGENT_IDENTITY_SEED_FRAUD=
AGENT_IDENTITY_SEED_PAYOUT=

# --- Data gateway -----------------------------------------------------------------
# HMAC key for pseudonymised claim reads (fraud agent). Only the gateway holds it.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
PSEUDONYMISATION_HMAC_KEY=
DATA_GATEWAY_PORT=8200

# --- Observability: Arize Phoenix (started by `npm run dev`) ----------------------
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# --- Console (Next.js) ------------------------------------------------------------
# Browser-side API addresses; also set them in frontend/.env.local.
NEXT_PUBLIC_AGENTOS_URL=http://localhost:8000
NEXT_PUBLIC_OFFICER_API_URL=http://localhost:8400
# Sign-in session secret (32+ random characters) goes in frontend/.env.local, not here:
# CONSOLE_SESSION_SECRET=
