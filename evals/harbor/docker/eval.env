AGENTOS_PORT=8000

# GROQ_API_KEY is deliberately NOT baked in here — it's the one real secret
# a task run actually needs (agents make real LLM calls), supplied by
# `harbor run`'s own env passthrough / the invoking shell's environment,
# never committed. See evals/harbor/README.md for how it's wired through.

# PHOENIX_COLLECTOR_ENDPOINT intentionally unset: this container has no
# Phoenix sidecar of its own (a per-task Phoenix instance is unnecessary
# eval overhead) — observability/tracing.py's OTLP exporter degrades to
# retry-and-drop against a refused connection (confirmed behaviour, not a
# crash — see M6 notes), which is an acceptable no-op for a throwaway eval
# container. The custom verifier (evals/harbor/adapter/verifier.py) checks
# governance evidence via the audit log (FlightRecorder), not spans, for
# exactly this reason — see that module's own docstring.
