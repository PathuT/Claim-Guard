# Shared env for every task's throwaway backend container (docs/adr/006).
# Keys here are fixed, checked-in throwaway values — NOT the real dev
# secrets in the project root .env, and safe to commit: they exist only to
# make signatures verify consistently *within one disposable container's
# lifetime*, the same reason .env.example documents this pattern for the
# real dev stack (auth/keys.py, governance/identity.py's own docstrings).
# A different, real random value per eval run would work exactly as well
# for that goal; these are fixed only so this file's content matches
# byte-for-byte across every task's docker-compose.yaml `env_file` — one
# generation, reused by reference, not regenerated per task.

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres
DIRECT_URL=postgresql://postgres:postgres@postgres:5432/postgres

# GEMINI_API_KEY intentionally unset: seed.py already handles this
# gracefully (policy_terms.embedding left NULL, everything else seeds
# normally) — none of S01-S10 depend on vector search, and skipping it
# avoids a real Gemini API call (cost + latency + a flaky external
# dependency) on every single task run. If a future scenario needs
# retrieval, pass a real key via docker-compose.yaml's own environment
# override for that one task instead of changing this shared file.

TOKEN_SERVICE_PORT=8100
TOKEN_SERVICE_PRIVATE_KEY=LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tCk1DNENBUUF3QlFZREsyVndCQ0lFSVA1NFlxYkt6V2ZhWmI0ZDBtZk1iT2MxRVZKOXRaWUd6am9NWVFYZWlabGYKLS0tLS1FTkQgUFJJVkFURSBLRVktLS0tLQo=

AGENT_IDENTITY_SEED_SUPERVISOR=lpRFHktE/2Gd/sMJAjuxSMPKfDp2tuY3LMTu2HZbFqE=
AGENT_IDENTITY_SEED_INTAKE=gEp1r6mKQgn3Dp4yziItCU4jpdOkOXNgo1t9ogPbrFw=
AGENT_IDENTITY_SEED_MEDICAL_REVIEWER=tFI4Hvb/B4vgs+HerNUsaL6rTIFSTkUL1du2fKnWxJk=
AGENT_IDENTITY_SEED_COVERAGE=7/8eP5i6gmXi3DpWUxWphlLGvP3VDK7WS32JXVDAKLU=
AGENT_IDENTITY_SEED_FRAUD=+ju1mdpC63G9JYL7mZ4OrI9C5+yC/HxSonmwYh6gOBM=
AGENT_IDENTITY_SEED_PAYOUT=n5gGFm1tzEi5yzFPR+6jBAGFoQF3h0QG57T9Szq/Fpo=

